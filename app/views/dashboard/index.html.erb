<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= @title %></title>
  <style>
    .dashboard-header {
      background: #ffffff;
      border-bottom: 1px solid #e5e7eb;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }
    .dashboard-header h1 {
      margin: 0;
      font-size: 1.5rem;
    }
    .user-info {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .user-name {
      color: #4b5563;
      font-weight: 500;
    }
    .btn-logout {
      padding: 0.5rem 1rem;
      background: #f3f4f6;
      color: #1a1a1a;
      text-decoration: none;
      border-radius: 0.5rem;
      border: 1px solid #e5e7eb;
      font-weight: 500;
      transition: all 0.2s ease;
    }
    .btn-logout:hover {
      background: #e5e7eb;
    }
  </style>
  
  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; margin: 2rem; }
    h1 { margin: 0 0 .25rem 0; }
    .muted { color: #666; margin-bottom: 1rem; }
    .row { display: flex; gap: 1rem; align-items: center; margin: 1rem 0; }
    table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
    .flash { background: #eefbea; border: 1px solid #bde5a6; padding: .5rem .75rem; margin: .75rem 0; }
    .btn { padding: .5rem .75rem; border: 1px solid #333; background: #fff; cursor: pointer; border-radius: .375rem; }
    .btn-primary { background: #0b57d0; color: #fff; border-color: #0b57d0; }
    .btn-secondary { background: #f6f6f6; color: #111; }
    .btn-danger { background: #a11; color: #fff; border-color: #a11; }
    .btn-sm { padding: .35rem .6rem; font-size: .9rem; }
    .btn-outline { background:#fff; color:#111; border-color:#bbb; }
    .badge { padding: .1rem .5rem; border-radius: .5rem; border: 1px solid #ccc; }
    .ok { color: #0a7a2f; border-color: #0a7a2f; }
    .not { color: #a11; border-color: #a11; }
    form { display: inline-block; }
    label { display: block; margin-top: .5rem; }
    input[type="text"], input[type="number"], input[type="date"] { padding: .4rem .5rem; width: 16rem; }
    .section { margin-top: 2rem; }
    details { border: 1px solid #ddd; border-radius: .5rem; padding: .75rem 1rem; background: #fafafa; }
    details > summary { cursor: pointer; font-weight: 600; }
    .status-badge { padding: .15rem .5rem; border-radius: .5rem; font-size: .85rem; }
    .status-active { background: #e6f4ea; color: #1e8e3e; }
    .status-expired { background: #fce8e6; color: #c5221f; }
    .export-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;          /* center vertically with CSV */
      gap: 1rem;
      margin: 1.5rem 0 2rem;
    }
    
    .export-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font: 600 16px/1.2 system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      padding: 0.85rem 1.2rem;
      border-radius: 999px;
      text-decoration: none;
      border: 1px solid transparent;
      cursor: pointer;
      transition: transform .02s ease, filter .15s ease, box-shadow .15s ease;
      box-shadow: 0 1px 2px rgba(0,0,0,.06);
    }
    .export-btn:hover { filter: brightness(0.95); }
    .export-btn:active { transform: translateY(1px); }
    
    .export-btn--csv  { background: #1a73e8; color: #fff; }
    .export-btn--ical { background: #1e8e3e; color: #fff; }
    
    /* --- New: iCal "combo pill" --- */
    .ical-combo {
      display: inline-flex;
      align-items: center;
      gap: .75rem;                     /* space between button and options */
      padding: .35rem .5rem .35rem .35rem;
      border: 1px solid #cce7d4;       /* light green border */
      background: #eef7f0;             /* pale green bg */
      border-radius: 999px;            /* capsule */
      box-shadow: 0 1px 2px rgba(0,0,0,.06);
    }
    
    /* keep the iCal button flush inside the capsule */
    .ical-combo .export-btn--ical {
      margin: 0;
    }
    
    /* thin divider between button and checkboxes */
    .ical-divider {
      width: 1px;
      height: 1.6rem;
      background: #cce7d4;
    }
    
    /* Reminders inline inside the capsule */
    .ical-reminders-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: .75rem 1rem;
      padding-right: .25rem;
    }
    
    .ical-label {
      font-weight: 600;
      color: #1f3b2b;
      margin-right: .25rem;
      font-size: .95rem;
    }
    
    .ical-reminders-row label {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font-size: .95rem;
      color: #111827;
    }
    
    /* small visual polish for native checkbox */
    .ical-reminders-row input[type="checkbox"] {
      transform: translateY(1px) scale(0.95);
    }
    
    /* Filter bar */
    .filters { margin: 1rem 0 0.5rem; }
    .filters-form { display:flex; flex-wrap:wrap; gap:.5rem 1rem; align-items:flex-end; }
    .filters-form .control { display:flex; flex-direction:column; gap:.25rem; }
    .filters-form .control label { margin-top: 0; font-size: .9rem; color:#444; }
    .filters-form select,
    .filters-form input[type="text"] { height: 34px; padding: .25rem .5rem; min-width: 12rem; border:1px solid #bbb; border-radius: .35rem; }
    .filters-actions { display:flex; align-items:center; gap:.5rem; }
    .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); border:0; }
    
    /* Action button styles */
    .action-btn {
      border: none;
      padding: 0.4rem 0.6rem;
      border-radius: 0.25rem;
      cursor: pointer;
      font-size: 0.85rem;
      transition: all 0.2s ease;
      margin: 0 0.1rem;
    }
    .edit-btn {
      background: #6c757d;
      color: white;
    }
    .edit-btn:hover {
      background: #5a6268;
    }
    .delete-btn {
      background: #e74c3c;
      color: white;
    }
    .delete-btn:hover {
      background: #c0392b;
    }
    .estimate-indicator {
      color: #f39c12;
      font-size: 0.8rem;
      margin-left: 0.25rem;
    }
  </style>
</head>
<body>
  <div class="dashboard-header">
    <div>
      <h1><%= @title %></h1>
      <div class="muted"><%= @subtitle %></div>
    </div>
    <div class="user-info">
      <% if user_signed_in? %>
        <span class="user-name">
          <% if current_user.name.present? %>
            <%= current_user.name %>
          <% else %>
            <%= current_user.email %>
          <% end %>
        </span>
        <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "btn-logout", form: { style: "display: inline;" } %>
      <% end %>
    </div>
  </div>

<div class="row">
  <% if @gmail_connected %>
    <span class="badge ok">Connected</span>
    <%= button_to "Parse Gmail Receipts", "/parse_gmail_receipts", method: :post, class: "btn btn-primary" %>
    <%= button_to "Disconnect Gmail", "/disconnect_gmail", method: :post, class: "btn btn-danger" %>
  <% else %>
    <%= button_to "Connect Gmail", user_google_oauth2_omniauth_authorize_path, method: :post, class: "btn btn-primary", data: { turbo: false } %>
    <span class="badge not">Not Connected</span>
  <% end %>
</div>


  <div class="filters">
    <form action="<%= dashboard_path %>" method="get" class="filters-form">
      <div class="control">
        <label class="visually-hidden" for="filter-search">Search</label>
        <input id="filter-search" type="text" name="search" value="<%= h(@search_term) %>" placeholder="Search product or merchant" />
      </div>
      <div class="control">
        <label class="visually-hidden" for="filter-status">Status</label>
        <select id="filter-status" name="status">
          <option value="" <%= 'selected' if @status_filter.blank? %>>All</option>
          <option value="active" <%= 'selected' if @status_filter == 'active' %>>Active</option>
          <option value="expired" <%= 'selected' if @status_filter == 'expired' %>>Expired</option>
          <option value="expiring_soon" <%= 'selected' if @status_filter == 'expiring_soon' %>>Expiring Soon</option>
        </select>
      </div>
      <div class="control">
        <label class="visually-hidden" for="filter-merchant">Merchant</label>
        <select id="filter-merchant" name="merchant">
          <option value="" <%= 'selected' if @merchant_filter.blank? %>>All</option>
          <% @merchants.each do |m| %>
            <option value="<%= h(m) %>" <%= 'selected' if @merchant_filter == m %>><%= m %></option>
          <% end %>
        </select>
      </div>
      <div class="control">
        <label class="visually-hidden" for="filter-sort">Sort by</label>
        <select id="filter-sort" name="sort">
          <option value="expiry_date" <%= 'selected' if @sort_by == 'expiry_date' %>>Expiry Date</option>
          <option value="product_name" <%= 'selected' if @sort_by == 'product_name' %>>Product Name</option>
          <option value="purchase_date" <%= 'selected' if @sort_by == 'purchase_date' %>>Purchase Date</option>
          <option value="merchant" <%= 'selected' if @sort_by == 'merchant' %>>Merchant</option>
        </select>
      </div>
      <div class="filters-actions">
        <button type="submit" class="btn btn-secondary btn-sm">Apply</button>
        <a href="/" class="btn btn-outline btn-sm">Reset</a>
      </div>
    </form>
  </div>

  <details class="section">
    <summary>Add a product warranty</summary>
    <div style="margin-top:.75rem;">
      <form action="/upload" method="post">
        <%= csrf_meta_tags %>
        <label>Product
          <input type="text" name="product" required />
        </label>
        <label>Merchant (optional)
          <input type="text" name="merchant" />
        </label>
        <label>Purchase Date
          <input type="date" name="purchase_date" value="<%= Date.today.strftime('%Y-%m-%d') %>" />
        </label>
        <label>Warranty Length (months)
          <input type="number" name="warranty_length" value="12" min="0" />
        </label>
        <button type="submit" class="btn btn-secondary">Add warranty</button>
      </form>
    </div>
  </details>

  

  <h3>Warranties</h3>
  <table aria-label="warranties">
    <thead>
      <tr>
        <th>Product</th><th>Merchant</th><th>Purchase Date</th><th>Warranty (months)</th><th>Expires</th><th>Status</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if @warranties.empty? %>
        <tr><td colspan="7">No warranties yet.</td></tr>
      <% else %>
        <% @warranties.each do |w| %>
          <tr data-warranty-id="<%= w.id %>">
            <td><%= w.product_name %></td>
            <td><%= w.merchant %></td>
            <td><%= w.purchase_date.strftime("%Y-%m-%d") %></td>
            <td>
              <%= w.warranty_months %>
              <% if w.warranty_months == 12 && w.source&.include?('parsed') %>
                <span class="estimate-indicator" title="Estimated warranty length">~</span>
              <% end %>
            </td>
            <td><%= w.expiry_date&.strftime("%Y-%m-%d") || '-' %></td>
            <td>
              <% if w.expiry_date && w.expiry_date >= Date.today %>
                <span class="status-badge status-active">Active</span>
              <% else %>
                <span class="status-badge status-expired">Expired</span>
              <% end %>
            </td>
            <td>
              <button class="action-btn edit-btn" data-warranty-id="<%= w.id %>" title="Edit warranty">
                ✏️
              </button>
              <button class="action-btn delete-btn" data-warranty-id="<%= w.id %>" title="Delete warranty">
                🗑️
              </button>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <div class="export-actions" role="group" aria-label="Export actions">
  <%= link_to "⬇️ Export CSV",
              export_products_path(format: :csv),
              class: "export-btn export-btn--csv",
              title: "Download CSV" %>
  
 <%= form_with url: calendar_products_path,
              method: :get,
              local: true,
              data: { turbo: false },
              html: { class: "ical-combo" } do %>

  <button type="submit" class="export-btn export-btn--ical" title="Download iCal">
    📅 Export iCal
  </button>
  <span class="ical-divider" aria-hidden="true"></span>


  <span class="ical-divider" aria-hidden="true"></span>

  <div class="ical-reminders-row" role="group" aria-label="iCal reminders">
    <span class="ical-label">Reminders:</span>
    <label><input type="checkbox" name="reminders[]" value="0"
      <%= "checked" if Array(params[:reminders]).include?("0") %> > same day</label>
    <label><input type="checkbox" name="reminders[]" value="1"
      <%= "checked" if Array(params[:reminders]).include?("1") %> > 1 day</label>
    <label><input type="checkbox" name="reminders[]" value="7"
      <%= "checked" if Array(params[:reminders]).include?("7") %> > 7 days</label>
    <label><input type="checkbox" name="reminders[]" value="30"
      <%= "checked" if Array(params[:reminders]).include?("30") %> > 30 days</label>
  </div>
<% end %>


  


</div>

<!-- Edit Modal -->
<div id="editModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000;">
  <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 2rem; border-radius: 0.5rem; min-width: 400px; max-width: 600px;">
    <h3 style="margin-top: 0;">Edit Warranty</h3>
    <form id="editForm">
      <input type="hidden" id="editWarrantyId" name="id">
      <div style="margin-bottom: 1rem;">
        <label for="editProductName" style="display: block; margin-bottom: 0.25rem; font-weight: 600;">Product Name</label>
        <input type="text" id="editProductName" name="product_name" style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 0.25rem;">
      </div>
      <div style="margin-bottom: 1rem;">
        <label for="editMerchant" style="display: block; margin-bottom: 0.25rem; font-weight: 600;">Merchant</label>
        <input type="text" id="editMerchant" name="merchant" style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 0.25rem;">
      </div>
      <div style="margin-bottom: 1rem;">
        <label for="editPurchaseDate" style="display: block; margin-bottom: 0.25rem; font-weight: 600;">Purchase Date</label>
        <input type="date" id="editPurchaseDate" name="purchase_date" style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 0.25rem;">
      </div>
      <div style="margin-bottom: 1rem;">
        <label for="editWarrantyMonths" style="display: block; margin-bottom: 0.25rem; font-weight: 600;">Warranty Length (months)</label>
        <input type="number" id="editWarrantyMonths" name="warranty_months" min="0" style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 0.25rem;">
      </div>
      <div style="display: flex; gap: 1rem; justify-content: flex-end;">
        <button type="button" id="cancelEdit" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
(function() {
  // Handle action button clicks
  document.addEventListener('click', (e) => {
    if (e.target.classList.contains('delete-btn')) {
      e.preventDefault();
      e.stopPropagation();
      
      const warrantyId = e.target.getAttribute('data-warranty-id');
      const row = e.target.closest('tr');
      
      if (warrantyId && row) {
        deleteWarranty(warrantyId, row);
      }
    } else if (e.target.classList.contains('edit-btn')) {
      e.preventDefault();
      e.stopPropagation();
      
      const warrantyId = e.target.getAttribute('data-warranty-id');
      const row = e.target.closest('tr');
      
      if (warrantyId && row) {
        editWarranty(warrantyId, row);
      }
    }
  });
  
  function editWarranty(warrantyId, row) {
    const cells = row.querySelectorAll('td');
    const productName = cells[0].textContent.trim();
    const merchant = cells[1].textContent.trim();
    const purchaseDate = cells[2].textContent.trim();
    const warrantyMonths = cells[3].textContent.replace('~', '').trim();
    
    document.getElementById('editWarrantyId').value = warrantyId;
    document.getElementById('editProductName').value = productName;
    document.getElementById('editMerchant').value = merchant;
    document.getElementById('editPurchaseDate').value = purchaseDate;
    document.getElementById('editWarrantyMonths').value = warrantyMonths;
    
    document.getElementById('editModal').style.display = 'block';
  }
  
  function deleteWarranty(warrantyId, row) {
    const deleteUrl = `/warranties/${warrantyId}`;
    
    fetch(deleteUrl, {
      method: 'DELETE',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '',
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin'
    })
    .then(response => {
      row.style.transition = 'opacity 0.3s ease';
      row.style.opacity = '0';
      setTimeout(() => {
        row.remove();
        const tbody = document.querySelector('table tbody');
        if (tbody && tbody.querySelectorAll('tr').length === 0) {
          tbody.innerHTML = '<tr><td colspan="8">No warranties yet.</td></tr>';
        }
      }, 300);
    })
    .catch(error => {
      console.error('Error deleting warranty:', error);
    });
  }
  
  document.getElementById('editForm').addEventListener('submit', (e) => {
    e.preventDefault();
    
    const formData = new FormData(e.target);
    const warrantyId = formData.get('id');
    const updateUrl = `/warranties/${warrantyId}`;
    
    const updateData = {
      product_name: formData.get('product_name'),
      merchant: formData.get('merchant'),
      purchase_date: formData.get('purchase_date'),
      warranty_months: formData.get('warranty_months')
    };
    
    fetch(updateUrl, {
      method: 'PATCH',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '',
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin',
      body: JSON.stringify(updateData)
    })
    .then(response => {
      if (response.ok) {
        document.getElementById('editModal').style.display = 'none';
        location.reload();
      } else {
        console.error('Failed to update warranty');
      }
    })
    .catch(error => {
      console.error('Error updating warranty:', error);
    });
  });
  
  document.getElementById('cancelEdit').addEventListener('click', () => {
    document.getElementById('editModal').style.display = 'none';
  });
  
  document.getElementById('editModal').addEventListener('click', (e) => {
    if (e.target.id === 'editModal') {
      document.getElementById('editModal').style.display = 'none';
    }
  });
})();
</script>

</body>
</html>
