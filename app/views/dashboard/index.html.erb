<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= @title %></title>
  
  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; margin: 2rem; }
    h1 { margin: 0 0 .25rem 0; }
    .muted { color: #666; margin-bottom: 1rem; }
    .row { display: flex; gap: 1rem; align-items: center; margin: 1rem 0; }
    table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
    .flash { background: #eefbea; border: 1px solid #bde5a6; padding: .5rem .75rem; margin: .75rem 0; }
    .btn { padding: .5rem .75rem; border: 1px solid #333; background: #fff; cursor: pointer; border-radius: .375rem; }
    .btn-primary { background: #0b57d0; color: #fff; border-color: #0b57d0; }
    .btn-secondary { background: #f6f6f6; color: #111; }
    .btn-danger { background: #a11; color: #fff; border-color: #a11; }
    .btn-sm { padding: .35rem .6rem; font-size: .9rem; }
    .btn-outline { background:#fff; color:#111; border-color:#bbb; }
    .badge { padding: .1rem .5rem; border-radius: .5rem; border: 1px solid #ccc; }
    .ok { color: #0a7a2f; border-color: #0a7a2f; }
    .not { color: #a11; border-color: #a11; }
    form { display: inline-block; }
    label { display: block; margin-top: .5rem; }
    input[type="text"], input[type="number"], input[type="date"] { padding: .4rem .5rem; width: 16rem; }
    .section { margin-top: 2rem; }
    details { border: 1px solid #ddd; border-radius: .5rem; padding: .75rem 1rem; background: #fafafa; }
    details > summary { cursor: pointer; font-weight: 600; }
    .status-badge { padding: .15rem .5rem; border-radius: .5rem; font-size: .85rem; }
    .status-active { background: #e6f4ea; color: #1e8e3e; }
    .status-expired { background: #fce8e6; color: #c5221f; }
    .export-actions {
      display: flex;
      justify-content: center;
      gap: 1rem;              /* space BETWEEN buttons */
      margin: 2.25rem 0 3rem; /* space ABOVE and BELOW the buttons */
    }
    
    .export-btn {
      font-size: 1rem;
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 0.5rem;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      transition: transform 0.2s ease, filter 0.2s ease;
      text-decoration: none; /* for <a> links */
      display: inline-block;
    }
    
    .export-btn:hover { transform: translateY(-2px); filter: brightness(0.95); }
    
    /* CSV: blue */
    .export-btn--csv { background: #0b57d0; color: #fff; }
    .export-btn--csv:hover { filter: brightness(0.92); }
    
    /* iCal: green */
   .export-btn--ical {
  background: #7b1fa2;     
  color: #fff;
}
.export-btn--ical:hover {
  filter: brightness(0.9);
}
    


    /* Filter bar */
    .filters { margin: 1rem 0 0.5rem; }
    .filters-form { display:flex; flex-wrap:wrap; gap:.5rem 1rem; align-items:flex-end; }
    .filters-form .control { display:flex; flex-direction:column; gap:.25rem; }
    .filters-form .control label { margin-top: 0; font-size: .9rem; color:#444; }
    .filters-form select,
    .filters-form input[type="text"] { height: 34px; padding: .25rem .5rem; min-width: 12rem; border:1px solid #bbb; border-radius: .35rem; }
    .filters-actions { display:flex; align-items:center; gap:.5rem; }
    .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); border:0; }
  </style>
</head>
<body>
  <h1><%= @title %></h1>
  <div class="muted"><%= @subtitle %></div>

  <% if flash[:notice] %>
    <div class="flash"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="flash" style="background:#ffdede;"><%= flash[:alert] %></div>
  <% end %>

<div class="row">
  <% if @gmail_connected %>
    <span class="badge ok">Connected</span>
    <%= button_to "Parse Gmail Receipts", "/parse_gmail_receipts", method: :post, class: "btn btn-primary" %>
    <%= button_to "Disconnect Gmail", "/disconnect_gmail", method: :post, class: "btn btn-danger" %>
  <% else %>
    <%= button_to "Connect Gmail", "/auth/google_oauth2", method: :post, class: "btn btn-primary", data: { turbo: false } %>
    <span class="badge not">Not Connected</span>
  <% end %>
</div>


  <div class="filters">
    <form action="/" method="get" class="filters-form">
      <div class="control">
        <label class="visually-hidden" for="filter-search">Search</label>
        <input id="filter-search" type="text" name="search" value="<%= h(@search_term) %>" placeholder="Search product or merchant" />
      </div>
      <div class="control">
        <label class="visually-hidden" for="filter-status">Status</label>
        <select id="filter-status" name="status">
          <option value="" <%= 'selected' if @status_filter.blank? %>>All</option>
          <option value="active" <%= 'selected' if @status_filter == 'active' %>>Active</option>
          <option value="expired" <%= 'selected' if @status_filter == 'expired' %>>Expired</option>
          <option value="expiring_soon" <%= 'selected' if @status_filter == 'expiring_soon' %>>Expiring Soon</option>
        </select>
      </div>
      <div class="control">
        <label class="visually-hidden" for="filter-merchant">Merchant</label>
        <select id="filter-merchant" name="merchant">
          <option value="" <%= 'selected' if @merchant_filter.blank? %>>All</option>
          <% @merchants.each do |m| %>
            <option value="<%= h(m) %>" <%= 'selected' if @merchant_filter == m %>><%= m %></option>
          <% end %>
        </select>
      </div>
      <div class="control">
        <label class="visually-hidden" for="filter-sort">Sort by</label>
        <select id="filter-sort" name="sort">
          <option value="expiry_date" <%= 'selected' if @sort_by == 'expiry_date' %>>Expiry Date</option>
          <option value="product_name" <%= 'selected' if @sort_by == 'product_name' %>>Product Name</option>
          <option value="purchase_date" <%= 'selected' if @sort_by == 'purchase_date' %>>Purchase Date</option>
          <option value="merchant" <%= 'selected' if @sort_by == 'merchant' %>>Merchant</option>
        </select>
      </div>
      <div class="filters-actions">
        <button type="submit" class="btn btn-secondary btn-sm">Apply</button>
        <a href="/" class="btn btn-outline btn-sm">Reset</a>
      </div>
    </form>
  </div>

  <details class="section">
    <summary>Add a product warranty</summary>
    <div style="margin-top:.75rem;">
      <form action="/upload" method="post">
        <%= csrf_meta_tags %>
        <label>Product
          <input type="text" name="product" required />
        </label>
        <label>Merchant (optional)
          <input type="text" name="merchant" />
        </label>
        <label>Purchase Date
          <input type="date" name="purchase_date" value="<%= Date.today.strftime('%Y-%m-%d') %>" />
        </label>
        <label>Warranty Length (months)
          <input type="number" name="warranty_length" value="12" min="0" />
        </label>
        <button type="submit" class="btn btn-secondary">Add warranty</button>
      </form>
    </div>
  </details>

  

  <h3>Warranties</h3>
  <table aria-label="warranties">
    <thead>
      <tr>
        <th>Product</th><th>Merchant</th><th>Purchase Date</th><th>Warranty (months)</th><th>Expires</th><th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% if @warranties.empty? %>
        <tr><td colspan="6">No warranties yet.</td></tr>
      <% else %>
        <% @warranties.each do |w| %>
          <tr>
            <td><%= w.product_name %></td>
            <td><%= w.merchant %></td>
            <td><%= w.purchase_date.strftime("%Y-%m-%d") %></td>
            <td><%= w.warranty_months %></td>
            <td><%= w.expiry_date&.strftime("%Y-%m-%d") || '-' %></td>
            <td>
              <% if w.expiry_date && w.expiry_date >= Date.today %>
                <span class="status-badge status-active">Active</span>
              <% else %>
                <span class="status-badge status-expired">Expired</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
  
  <div class="export-actions" role="group" aria-label="Export actions">
  <%= link_to "⬇️ Export CSV", export_products_path(format: :csv), class: "export-btn export-btn--csv" %>
  <%= link_to "📅 Export iCal", calendar_products_path, class: "export-btn export-btn--ical" %>
</div>

</div>

</body>
</html>
